# Copy this file to ".env" and fill in ONE provider. Real environment variables win over this file.
# With no provider the app still works fully: replies come from the verified templates.

# --- Option 1: a local model with Ollama (free, offline, no key) -- what you are using ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
LLM_TIMEOUT=90

# --- Option 2: Anthropic (Claude) ---
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# --- Option 3: OpenAI, or any OpenAI-compatible service (Groq, Together, OpenRouter, ...) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- FAQ answers with similarity at/above this are sent as written (no LLM rewrite). 2 = always use the LLM ---
# FAQ_VERBATIM_ABOVE=0.85

# --- Optional: server-side speech recognition model size (tiny, base, small, medium) ---
# WHISPER_MODEL=base
